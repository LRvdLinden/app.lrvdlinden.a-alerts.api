# A-Alerts API gateway: every request goes to index.php, which passes it on to the real API.
Options -Indexes
AddDefaultCharset Off
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]
  # Authorization reaches PHP on every host
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^config\.php$ - [F,L]
  # Internal PHP collectors are never HTTP endpoints.
  RewriteRule ^_core(/|$) - [F,L]
  RewriteRule ^_core/docs-auth\.local\.php$ - [F,L]
  # Only publicly served asset; all docs HTML goes through authenticated PHP.
  RewriteRule ^docs/(style|brand|status)\.css$ - [L]
  # Source-owned static image previews for authenticated docs pages.
  RewriteRule ^images/ - [L]
  RewriteRule ^ index.php [L]
</IfModule>
# No extra headers: the answer must be the same as that of the real API. PHP compresses the answer itself.
<IfModule mod_headers.c>
  Header unset X-Powered-By
</IfModule>
<IfModule mod_env.c>
  SetEnv no-gzip 1
  SetEnv no-brotli 1
</IfModule>

<FilesMatch "^(docs-auth\.local\.php|docs-auth\.php)$">
  Require all denied
</FilesMatch>

# Standalone SVGs must never execute scripts if opened directly.
<IfModule mod_headers.c>
  <FilesMatch "\\.svg$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>
